---
layout: base.njk
---
<div class="detail-container">
  <div class="about-hero">
    <div class="about-avatar-wrapper">
      <img src="/images/martin-splitt-portrait.jpg" alt="Martin Splitt — Photographer">
    </div>
    <div class="about-bio">
      <h1>Martin Splitt</h1>
      <p class="about-subtitle">Landscape, Aerial, Underwater & Architecture Photographer</p>
      <div class="about-text">
        {{ content | safe }}
      </div>
    </div>
  </div>

  <section class="awards-section">
    <h2>1x.com Curated & Awarded Works</h2>
    <p style="color: var(--text-muted); margin-bottom: 2rem; max-width: 700px;">Official curation awards presented on 1x.com, the premier curated photography gallery.</p>
    
    <div class="awards-grid" style="margin-bottom: 4rem;">
      <!-- 1x Stadium Night -->
      <a href="/images/awards/1x-stadium-night-award.jpg" target="_blank" class="award-card">
        <img src="/images/awards/1x-stadium-night-award.jpg" alt="1x.com Awarded - Stadium Aerial at Night" class="award-badge-img" style="object-fit: cover; border-radius: 8px;">
        <div class="award-details">
          <h3>Stadium Aerial at Night</h3>
          <p style="color: var(--accent-cyan); font-weight: 600;">Awarded on 1x.com</p>
          <span style="font-size: 0.8rem; color: var(--text-muted);">Official 1x Gallery Award</span>
        </div>
      </a>

      <!-- 1x Brighton Pier -->
      <a href="/images/awards/1x-brighton-palace-pier-award.jpg" target="_blank" class="award-card">
        <img src="/images/awards/1x-brighton-palace-pier-award.jpg" alt="1x.com Awarded - Brighton Palace Pier Aerial" class="award-badge-img" style="object-fit: cover; border-radius: 8px;">
        <div class="award-details">
          <h3>Brighton Palace Pier Aerial</h3>
          <p style="color: var(--accent-cyan); font-weight: 600;">Awarded on 1x.com</p>
          <span style="font-size: 0.8rem; color: var(--text-muted);">Official 1x Gallery Award</span>
        </div>
      </a>

      <!-- 1x Forest Light -->
      <a href="/images/awards/1x-light-breaking-through-trees-award.jpg" target="_blank" class="award-card">
        <img src="/images/awards/1x-light-breaking-through-trees-award.jpg" alt="1x.com Awarded - Light Breaking Through Trees" class="award-badge-img" style="object-fit: cover; border-radius: 8px;">
        <div class="award-details">
          <h3>Licht bricht im Nebel durch die Bäume</h3>
          <p style="color: var(--accent-cyan); font-weight: 600;">Awarded on 1x.com</p>
          <span style="font-size: 0.8rem; color: var(--text-muted);">Official 1x Gallery Award</span>
        </div>
      </a>
    </div>

    <h2>Top Photo Awards & Official Certificates</h2>
    <p style="color: var(--text-muted); margin-bottom: 2rem; max-width: 700px;">International contest achievements and juried certificates from Top Photo Awards.</p>
    
    <div class="awards-grid">
      <!-- Urban Architecture 2026 -->
      <a href="/images/awards/tpa-urban-architecture-expert-choice-2026.jpg" target="_blank" class="award-card">
        <img src="/images/awards/tpa-urban-architecture-expert-choice-2026.jpg" alt="Urban Architecture Photography Contest Certificate" class="award-badge-img" style="object-fit: cover; border-radius: 8px;">
        <div class="award-details">
          <h3>Urban Architecture Contest</h3>
          <p style="color: var(--accent-cyan); font-weight: 600;">Expert Choice Award (2026)</p>
          <span style="font-size: 0.8rem; color: var(--text-muted);">May 15, 2026 • 1,924+ entries</span>
        </div>
      </a>

      <!-- This is Love 2026 -->
      <a href="/images/awards/tpa-this-is-love-top20-2026.jpg" target="_blank" class="award-card">
        <img src="/images/awards/tpa-this-is-love-top20-2026.jpg" alt="This Is Love Photo Contest 2026 Certificate" class="award-badge-img" style="object-fit: cover; border-radius: 8px;">
        <div class="award-details">
          <h3>This Is Love Photo Contest</h3>
          <p style="color: var(--accent-cyan); font-weight: 600;">Top 20 Award (2026)</p>
          <span style="font-size: 0.8rem; color: var(--text-muted);">May 22, 2026 • 1,195+ entries</span>
        </div>
      </a>

      <!-- Street Life in Color 2025 -->
      <a href="/images/awards/tpa-street-life-color-expert-choice-2025.jpg" target="_blank" class="award-card">
        <img src="/images/awards/tpa-street-life-color-expert-choice-2025.jpg" alt="Street Life in Color Photo Contest Certificate" class="award-badge-img" style="object-fit: cover; border-radius: 8px;">
        <div class="award-details">
          <h3>Street Life In Color Contest</h3>
          <p style="color: var(--accent-cyan); font-weight: 600;">Expert Choice Award (2025)</p>
          <span style="font-size: 0.8rem; color: var(--text-muted);">December 5, 2025 • 3,632+ entries</span>
        </div>
      </a>

      <!-- TPA Aerial 2025 -->
      <div class="award-card">
        <img src="/images/awards/tpa-aerial-top10-2025.jpg" alt="TPA Aerial Photo Awards Top 10" class="award-badge-img">
        <div class="award-details">
          <h3>TPA Aerial Photo Awards</h3>
          <p style="color: var(--accent-cyan); font-weight: 600;">Top 10 Finalist (2025)</p>
        </div>
      </div>

      <!-- TPA Wildlife 2025 -->
      <div class="award-card">
        <img src="/images/awards/tpa-wildlife-top50-2025.jpg" alt="TPA Wildlife Photo Awards Top 50" class="award-badge-img">
        <div class="award-details">
          <h3>TPA Wildlife Photo Awards</h3>
          <p style="color: var(--accent-cyan); font-weight: 600;">Top 50 Selection (2025)</p>
        </div>
      </div>
    </div>
  </section>
</div>
